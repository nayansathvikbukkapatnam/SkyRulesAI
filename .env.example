# Copy to .env and fill in locally. Never commit .env.

# LLM backend: anthropic (Claude API) or bedrock (AWS Bedrock). One switch, same interface.
LLM_PROVIDER=anthropic
# Claude API key from console.anthropic.com. Leave empty here; set it only in your .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-haiku-5-5

# Bedrock (used when LLM_PROVIDER=bedrock). Use a named AWS CLI profile
# (aws configure --profile <name>); never put keys here.
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=

# Team contact email for the crawler's User-Agent
CRAWL_CONTACT_EMAIL=
